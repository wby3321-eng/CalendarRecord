# 复制为 .env 并按需修改（docker compose 会自动读取同目录 .env）

# 站点地址：本地用 localhost；生产填域名，Caddy 自动签发 HTTPS 证书
SITE_ADDRESS=localhost

# JWT 签名密钥（生产务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret

# HTTPS 下 Cookie 需为 secure；本地 http 调试可设为 false
COOKIE_SECURE=true

# 跨域来源（同源部署留空即可；多个用逗号分隔）
CORS_ORIGINS=

# 预置管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 智谱 GLM 配置（必须填入真实 API Key 才能使用 AI 分析）
GLM_API_KEY=REPLACE_WITH_ZHIPU_API_KEY
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
